{
  "compilerOptions": {
    "target": "ES2022", "module": "node16", "moduleResolution": "node16",
    "lib": ["ES2022"], "types": ["node"],
    "outDir": "out", "rootDir": ".",
    "strict": true, "noImplicitAny": true, "noUnusedLocals": true, "noImplicitReturns": true,
    "esModuleInterop": true, "skipLibCheck": true, "sourceMap": false
  },
  "include": ["src", "test"]
}
