{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kibo",
  "version": "0.1.0",
  "identifier": "dev.kairoqx.kibo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kibo",
        "url": "/",
        "width": 260,
        "height": 312,
        "minWidth": 240,
        "minHeight": 292,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A tiny coding companion",
    "longDescription": "Kibo is a cute desktop robot that cheers you on while you code."
  }
}
